# Copy to .env.local and fill in your values.
# The app degrades gracefully when REDIS_URL is unset (config caching is skipped).

# Connection string for the Redis instance used to cache per-API-URL
# configuration (multipliers, units, offsets). Any redis:// or rediss:// URL works.
REDIS_URL=redis://default:your-password@your-redis-host:6379
